# --- Database ---
# Local dev: mongodb://localhost:27017/helixql
# Production: MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/helixql

# --- App ---
# Public base URL of this deployment, used to build verification links.
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# --- Desktop downloads ---
# Public base URL of the bucket holding the installers and latest.json.
# Unset means the download page shows "Coming soon" for every platform.
DOWNLOADS_BASE_URL=
# Per-platform escape hatch, taking precedence over the manifest, for a host
# that does not serve predictable names from a shared base — a Google Drive or
# Dropbox share, say. One per platform: DOWNLOAD_URL_WINDOWS, _MAC_ARM64,
# _MAC_X64, _LINUX_APPIMAGE, _LINUX_DEB.
# For Google Drive use the direct-download form, not the share link:
#   https://drive.usercontent.google.com/download?id=<file-id>&export=download&confirm=t
DOWNLOAD_URL_WINDOWS=
# Version label for direct URLs, which carry no manifest to read one from.
DOWNLOADS_VERSION=

# --- Secrets ---
# Generate each with: openssl rand -hex 32
# Signs the short-lived web dashboard session cookie (JWT via `jose`).
SESSION_SECRET=
# HMAC key used to derive the deterministic, indexed lookup hash for api_tokens.
# Losing/rotating this invalidates all issued api_tokens.
API_TOKEN_HMAC_SECRET=
# AES-256-GCM key (must decode to exactly 32 bytes) used to encrypt api_tokens at rest
# so they can be decrypted and returned to a user on login. Generate with: openssl rand -hex 32
API_TOKEN_ENCRYPTION_KEY=
# Shared secret the FastAPI gateway presents on /api/internal/* calls (X-Internal-Secret header).
GATEWAY_INTERNAL_SECRET=

# --- SMTP (transactional email) ---
# Leave SMTP_HOST unset in local dev to fall back to a console-logging mailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HelixQL <no-reply@helixql.example.com>"
# Inbox that receives /contact form submissions. Defaults to SMTP_USER if unset.
SUPPORT_EMAIL=
