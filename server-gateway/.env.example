# Which provider synthesizes SQL: "gemini" or "groq".
# Groq is the pragmatic default for development — its free tier allows
# thousands of requests per day, where Gemini's allows about 20 per model.
LLM_PROVIDER=gemini

# --- Groq (used when LLM_PROVIDER=groq). https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0.0

# --- Gemini (used when LLM_PROVIDER=gemini) ---
# Google GenAI SDK key. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The spec names gemini-2.5-flash, but Google has closed that model to new
# API keys. Use a current Flash model unless your key still has 2.5 access.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.0
# Thinking is dialed down for deterministic translation. Gemini 3.x uses
# GEMINI_THINKING_LEVEL (low|high); Gemini 2.5 uses GEMINI_THINKING_BUDGET
# (0 disables, -1 dynamic). Set only the one matching your model — each
# generation rejects the other's field with a 400.
GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_BUDGET=0

# Where the control plane is reachable, and the shared secret it expects
# on the X-Internal-Secret header for /api/internal/* calls. This must
# match GATEWAY_INTERNAL_SECRET in control-plane/.env exactly.
CONTROL_PLANE_BASE_URL=http://localhost:3000
CONTROL_PLANE_INTERNAL_SECRET=

# --- Limits (optional; defaults shown) ---
# Self-healing retry ceiling for one question (FR-4.5).
# MAX_REPAIR_ATTEMPTS=3
# Row cap injected into generated SELECTs that carry no LIMIT of their own.
# MAX_RESULT_ROWS=1000
# LOG_LEVEL=INFO
