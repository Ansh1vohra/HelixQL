# Google GenAI SDK key (Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0

# Where the control plane is reachable, and the shared secret it expects
# on the X-Internal-Secret header for /api/internal/* calls. This must
# match GATEWAY_INTERNAL_SECRET in control-plane/.env exactly.
CONTROL_PLANE_BASE_URL=http://localhost:3000
CONTROL_PLANE_INTERNAL_SECRET=
