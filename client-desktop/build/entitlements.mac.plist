<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime, required for macOS notarization.

  Only the network client entitlement is requested: HelixQL opens outbound
  connections to the customer's database and to the gateway, and does
  nothing else that the sandbox restricts. No camera, microphone, file
  access, or JIT — asking for entitlements the app does not use is a
  notarization risk for no gain.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
